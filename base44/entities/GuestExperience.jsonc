{
  "name": "GuestExperience",
  "type": "object",
  "properties": {
    "rental_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "guest_name": {
      "type": "string"
    },
    "check_in_date": {
      "type": "string",
      "format": "date"
    },
    "check_out_date": {
      "type": "string",
      "format": "date"
    },
    "experience_type": {
      "type": "string",
      "enum": [
        "romantique",
        "famille",
        "aventure",
        "d\u00e9tente",
        "affaires",
        "groupe"
      ]
    },
    "personalized_touches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "local_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "special_requests": {
      "type": "string"
    },
    "satisfaction_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "review_text": {
      "type": "string"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "issues_encountered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "improvements_suggested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "would_return": {
      "type": "boolean"
    },
    "referral_likelihood": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    }
  },
  "required": [
    "property_name",
    "guest_name"
  ]
}
{
  "name": "FinancingPlan",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "pret_bancaire",
        "investisseur",
        "subvention",
        "apport_holding",
        "crowdfunding",
        "leasing",
        "autre"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "en_preparation",
        "soumis",
        "en_negociation",
        "approuv\u00e9",
        "refus\u00e9",
        "en_attente"
      ],
      "default": "en_preparation"
    },
    "amount_requested": {
      "type": "number"
    },
    "amount_obtained": {
      "type": "number"
    },
    "interest_rate": {
      "type": "number"
    },
    "duration_months": {
      "type": "integer"
    },
    "monthly_payment": {
      "type": "number"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_institution": {
      "type": "string"
    },
    "deadline_submission": {
      "type": "string",
      "format": "date"
    },
    "decision_date": {
      "type": "string",
      "format": "date"
    },
    "project_linked": {
      "type": "string"
    },
    "entity_linked": {
      "type": "string"
    },
    "documents_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documents_ready": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type",
    "amount_requested"
  ]
}
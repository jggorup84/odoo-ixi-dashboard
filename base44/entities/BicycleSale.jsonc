{
  "name": "BicycleSale",
  "type": "object",
  "properties": {
    "odoo_id": {
      "type": "integer"
    },
    "bicycle_model": {
      "type": "string"
    },
    "bicycle_type": {
      "type": "string",
      "enum": [
        "mountain",
        "road",
        "electric",
        "city",
        "hybrid"
      ]
    },
    "customer_name": {
      "type": "string"
    },
    "sale_date": {
      "type": "string",
      "format": "date"
    },
    "sale_price": {
      "type": "number"
    },
    "purchase_price": {
      "type": "number"
    },
    "margin": {
      "type": "number"
    },
    "warranty_months": {
      "type": "integer"
    },
    "includes_accessories": {
      "type": "boolean",
      "default": false
    },
    "accessories_list": {
      "type": "string"
    }
  },
  "required": [
    "bicycle_model",
    "customer_name",
    "sale_date"
  ]
}